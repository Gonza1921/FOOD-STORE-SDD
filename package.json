{
  "name": "food-store-sdd",
  "version": "1.0.0",
  "description": "Food Store - E-commerce platform with FastAPI backend and React frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "engram:export": "node .engram/engram-sync.cjs --export",
    "engram:import": "node .engram/engram-sync.cjs --import",
    "engram:status": "node .engram/engram-sync.cjs --status",
    "engram:help": "node .engram/engram-sync.cjs --help",
    "dev": "echo 'Run: cd frontend && pnpm dev'",
    "build": "echo 'Run: cd frontend && pnpm build'",
    "test": "echo 'Run: cd backend && pytest'"
  },
  "keywords": [
    "food-store",
    "ecommerce",
    "fastapi",
    "react",
    "engram"
  ],
  "author": "Food Store Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
