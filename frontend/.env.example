# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key-here
VITE_APP_NAME=FOOD STORE
VITE_APP_ENV=development

# MercadoPago Public Key
# - TEST mode: Use TEST-xxxx keys from MercadoPago Sandbox Console
# - PRODUCTION: Use APP_USR-xxxx keys from MercadoPago Production Console
# - Get keys from: https://www.mercadopago.com.ar/developers/panel

# Documentación: el frontend no consume REFRESH_TOKEN_EXPIRE_DAYS directamente,
# la expiración se maneja via el interceptor de Axios (401 → refresh automático).
